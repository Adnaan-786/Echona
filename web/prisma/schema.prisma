generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  name          String?
  mobile        String?
  role          Role      @default(USER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  participants    CompetitionParticipant[]
  submissions     Submission[]
  compileAttempts CompileAttempt[]
  draftCodes      DraftCode[]
  events          CompetitionEvent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Competition {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String    @default("DRAFT") // DRAFT, ACTIVE, ENDED
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rounds       Round[]
  participants CompetitionParticipant[]
  events       CompetitionEvent[]
}

model CompetitionParticipant {
  id            String   @id @default(cuid())
  competitionId String
  userId        String
  score         Int      @default(0)
  createdAt     DateTime @default(now())

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scores      Score[]

  @@unique([competitionId, userId])
}

model Round {
  id                 String    @id @default(cuid())
  competitionId      String
  name               String
  durationSeconds    Int
  order              Int
  status             String    @default("PENDING") // PENDING, ACTIVE, ENDED
  startedAt          DateTime?
  endsAt             DateTime?
  maxCompileAttempts Int
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  competition Competition        @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  questions   Question[]
  events      CompetitionEvent[]
}

model Question {
  id          String   @id @default(cuid())
  roundId     String
  title       String
  description String
  points      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  round           Round            @relation(fields: [roundId], references: [id], onDelete: Cascade)
  testCases       TestCase[]
  starterCodes    StarterCode[]
  submissions     Submission[]
  compileAttempts CompileAttempt[]
  draftCodes      DraftCode[]
}

model TestCase {
  id         String   @id @default(cuid())
  questionId String
  input      String
  expected   String
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model StarterCode {
  id         String   @id @default(cuid())
  questionId String
  language   String
  code       String
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, language])
}

model DraftCode {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  language   String
  code       String
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model CompileAttempt {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  language   String
  code       String
  result     String?
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Submission {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  language   String
  code       String
  status     String   @default("PENDING") // PENDING, EVALUATED, FAILED
  createdAt  DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  score      Score?
  aiAnalysis AIAnalysis?
}

model Score {
  id            String   @id @default(cuid())
  submissionId  String   @unique
  participantId String
  pointsEarned  Int
  passedCases   Int
  totalCases    Int
  createdAt     DateTime @default(now())

  submission  Submission             @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  participant CompetitionParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model AIAnalysis {
  id           String   @id @default(cuid())
  submissionId String   @unique
  correctness  Int
  codeQuality  Int
  bugs         String
  feedback     String
  status       String   @default("PENDING") // PENDING, COMPLETED, FAILED
  createdAt    DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model CompetitionEvent {
  id            String   @id @default(cuid())
  competitionId String?
  roundId       String?
  userId        String?
  eventType     String
  payload       String? // JSON
  createdAt     DateTime @default(now())

  competition Competition? @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  round       Round?       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
}
